{
    "name": "ca-certificates",
    "description": "Set of trusted root TLS certificates in PEM format, generated via mk-ca-bundle.pl from the Mozilla NSS trust store, installed to /etc/ssl for use by TLS-enabled programs.",
    "version": "3.106",
    "dependencies": [
        "curl",
        "perl"
    ],
    "download": [
        "curl -fL --retry 3 --retry-delay 2 -o certdata.txt https://raw.githubusercontent.com/curl/curl/curl-8_10_1/lib/mk-ca-bundle.pl",
        "curl -fL --retry 3 --retry-delay 2 -o certdata.txt.raw https://hg.mozilla.org/projects/nss/raw-file/NSS_3_106_RTM/lib/ckfw/builtins/certdata.txt"
    ],
    "build": [
        "mkdir -p etc/ssl/certs",
        "perl mk-ca-bundle.pl -n -u etc/ssl/certs/ca-certificates.crt"
    ],
    "install": [
        "install -d \"$DESTDIR$PREFIX/etc/ssl/certs\"",
        "install -m 644 etc/ssl/certs/ca-certificates.crt \"$DESTDIR$PREFIX/etc/ssl/certs/ca-certificates.crt\""
    ]
}
